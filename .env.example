# google-auth — обмен MCP-токена (POST /internal/mcp/token) и JWT
# (POST /internal/token/exchange) на JWT для wallet-report, ключи JWKS.
# Ручки служебные, гейтвей их не проксирует: адрес — внутренний.
AUTH_SERVICE_URL=http://127.0.0.1:8080

# X-Service-Secret wallet-mcp для обмена JWT (RFC 8693) — тот же, что у
# wallet-mcp в TOKEN_EXCHANGE_SECRETS google-auth. Пусто — JWT не
# принимается (только wmcp_…), в логе старта предупреждение.
# AUTH_EXCHANGE_SECRET=

# wallet-report — все данные инструментов (GET /api/reports/*), напрямую, не
# через гейтвей.
WALLET_REPORT_URL=http://127.0.0.1:8084

# wallet-docs — инструмент ask_docs («как работает система»), напрямую, не
# через гейтвей. Пусто — инструмента нет (в логе старта: docs tool disabled).
# Включать последним: после google-auth docs-mcp-audience и wallet-docs mcp-scope.
# WALLET_DOCS_URL=http://127.0.0.1:8089

PORT=8088
# 127.0.0.1 — только локально. В контейнере за гейтвеем — HOST=0.0.0.0.
HOST=127.0.0.1

# Пояс IANA для «сегодня» (instructions в initialize, list_wallets, balance
# без даты). По умолчанию UTC; неизвестный пояс — сервис не стартует.
# MCP_TZ=Europe/Moscow

# Логи: по умолчанию stdout/stderr (Linux/Docker), папка — файл на день.
# LOG_DIR=var/log/wallet-mcp
# LOG_LEVEL=info
