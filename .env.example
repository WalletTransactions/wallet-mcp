# google-auth — обмен MCP-токена на JWT (POST /internal/mcp/token). Ручка
# служебная, гейтвей её не проксирует: адрес — внутренний, по сети контура.
AUTH_SERVICE_URL=http://127.0.0.1:8080

# wallet-report — все данные инструментов (GET /api/reports/*), напрямую, не
# через гейтвей.
WALLET_REPORT_URL=http://127.0.0.1:8084

PORT=8088
# 127.0.0.1 — только локально. В контейнере за гейтвеем — HOST=0.0.0.0.
HOST=127.0.0.1

# Пояс IANA для «сегодня» (instructions в initialize, list_wallets, balance
# без даты). По умолчанию UTC; неизвестный пояс — сервис не стартует.
# MCP_TZ=Europe/Moscow

# Логи: по умолчанию stdout/stderr (Linux/Docker), папка — файл на день.
# LOG_DIR=var/log/wallet-mcp
# LOG_LEVEL=info
